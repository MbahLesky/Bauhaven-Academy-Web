# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase - the Bauhaven project (the same one every Bauhaven app uses)
# ---------------------------------------------------------------------------
# Both values are safe to expose to the browser: the anon key is public by
# design and the database's own rules protect the data. Never put the
# service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# This app's own public address
# ---------------------------------------------------------------------------
# Used to build the redirect on password-reset emails. A configured value
# rather than the request's Host header, which is attacker-controllable.
NEXT_PUBLIC_ACADEMY_URL=

# Copy to .env.local and fill in real values. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — from the project in bauhaven-platform/supabase
# ---------------------------------------------------------------------------
# The same project Admin-web points at. One Supabase Auth instance serves Core,
# Admin and Academy, so one account works everywhere — see
# Bauhaven-Architecture-Plan.md §6, "Auth strategy".
#
# Both values are safe to expose to the browser: the anon key is public by
# design and RLS is what protects the data. Never put the service_role key in
# this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# This app's own public address
# ---------------------------------------------------------------------------
# Used to build the redirect on password-reset emails. Built from a configured
# value rather than the request's Host header, which is attacker-controllable —
# a poisoned redirect on a reset link is a credential-harvesting page reached
# from a genuine email. Same name Admin-web uses for this app's address, so a
# deployment sets one value under one name.
NEXT_PUBLIC_ACADEMY_URL=
